# Copia questo file in .env.local per lo sviluppo locale
# Copia in .env sulla VPS per la produzione
# NON committare mai il file .env compilato: contiene la password della casella.

# Email nazionale (usata nei mailto precompilati)
NEXT_PUBLIC_EMAIL=info@rethinkuni.it

# --- SMTP: invio del form "Fonda Rethink nel tuo ateneo" ---
# Questi valori te li dà il provider della casella info@rethinkuni.it.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=info@rethinkuni.it
SMTP_PASS=

# Mittente delle email generate dal sito.
# Deve essere un indirizzo del tuo dominio, altrimenti SPF/DMARC le fanno finire in spam.
SMTP_FROM=info@rethinkuni.it

# Destinatario delle richieste inviate dal form.
CONTACT_TO=info@rethinkuni.it
